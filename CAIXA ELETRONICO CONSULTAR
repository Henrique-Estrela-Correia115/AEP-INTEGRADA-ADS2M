programa {
  funcao inicio() {
    inteiro opcap = 0
    real sldo = 10000.0 
    real valor

    faca {
      escreva("\n--- CAIXA ELETRÔNICO ---")
      escreva("\n1. Verificar Saldo")
      escreva("\n2. Realizar Saque")
      escreva("\n3. Realizar Depósito")
      escreva("\n4. Sair")
      escreva("\nEscolha uma opção: ")
      leia(opcap)

      escolha(opcap) {
        caso 1:
          escreva("\nSeu saldo atual é: R$ ", sldo, "\n")
          pare
        
        caso 2:
          escreva("\nDigite o valor do saque: R$ ")
          leia(valor)
          se (valor > sldo) {
            escreva("Saldo insuficiente!\n")
          } senao {
            sldo = sldo - valor
            escreva("Saque realizado com sucesso!\n")
          }
          pare
        
        caso 3:
          escreva("\nDigite o valor do depósito: R$ ")
          leia(valor)
          sldo = sldo + valor
          escreva("Depósito realizado com sucesso!\n")
          pare
        
        caso 4:
          escreva("\nSaindo do sistema... Obrigado!\n")
          pare
        
        caso contrario:
          escreva("\nOpção inválida! Tente novamente.\n")
      }

    } enquanto (opcap != 4)
  }
}
